# Zainussunna Academy - Calendar Fund Management System (ZCM)
# Production & Development Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL

# Application Mode & Secret Key
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production
ALLOWED_HOSTS=api-calendar.zainussunnaacademy.com,.vercel.app,localhost,127.0.0.1

# Production Database: Neon PostgreSQL Connection String (with Connection Pooling)
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local Database Fallback (if DATABASE_URL is not set)
DB_NAME=zainussunna_db
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://calendar.zainussunnaacademy.com,http://localhost:5173,http://localhost:5174

# Application Settings
TIME_ZONE=Asia/Kolkata
